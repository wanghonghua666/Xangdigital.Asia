rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 产品集合 - 允许所有人读写
    match /products/{productId} {
      allow read, write: if true;
    }
    
    // CD集合 - 允许所有人读写
    match /cds/{cdId} {
      allow read, write: if true;
    }
    
    // 产品页面集合 - 允许所有人读写
    match /productPages/{pageId} {
      allow read, write: if true;
    }
    
    // 图片集合 - 允许所有人读写
    match /images/{imageId} {
      allow read, write: if true;
    }
    
    // 其他集合的默认规则
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
